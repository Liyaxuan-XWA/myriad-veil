## 章节数量（面板用来做越界保护）
static func chapter_count() -> int:
	return CHAPTERS.size()


## 取某一章的标题（越界返回空串）
static func chapter_title(index: int) -> String:
	if index < 0 or index >= CHAPTERS.size():
		return ""
	return String((CHAPTERS[index] as Dictionary).get("title", ""))


## 取某一章的条目数组（越界返回空数组）
static func chapter_blocks(index: int) -> Array:
	if index < 0 or index >= CHAPTERS.size():
		return []
	return (CHAPTERS[index] as Dictionary).get("blocks", []) as Array


## 按章节 id 找章序 —— 给「从别处跳到指定一页」用（id 不存在返回 0）
static func chapter_index_by_id(chapter_id: String) -> int:
	for i in CHAPTERS.size():
		if String((CHAPTERS[i] as Dictionary).get("id", "")) == chapter_id:
			return i
	return 0
